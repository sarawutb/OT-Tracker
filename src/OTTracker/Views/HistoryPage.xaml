<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OTTracker.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:OTTracker.Controls"
    Title="History"
    Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="44,*,44" Margin="10,10,10,0">
                <Button Text="‹" Command="{Binding PreviousMonthCommand}" Style="{StaticResource GhostButton}" FontSize="22" />
                <Label Grid.Column="1" Text="{Binding MonthText}" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="›" Command="{Binding NextMonthCommand}" Style="{StaticResource GhostButton}" FontSize="22" />
            </Grid>
            <ActivityIndicator Grid.Row="1" IsVisible="{Binding IsBusy}" BackgroundColor="Transparent" Color="#5B4FE8" IsRunning="True" VerticalOptions="Center"/>
            <Grid
                Grid.Row="1"
                Padding="18"
                RowDefinitions="Auto,Auto,Auto,*"
                RowSpacing="12"
                IsVisible="{Binding IsBusy,Converter={StaticResource InverseBooleanConverter}}">
                
                <!-- 1. View Mode Segment Switcher -->
                <Border StrokeThickness="0" BackgroundColor="{StaticResource Surface2}" StrokeShape="RoundRectangle 50" HorizontalOptions="Center" Padding="0" HeightRequest="30">
                    <Grid ColumnDefinitions="*,*" WidthRequest="240">
                        <Button Text="Calendar" 
                                Command="{Binding ShowCalendarViewCommand}" 
                                FontSize="12" 
                                FontFamily="OpenSansSemibold" 
                                BackgroundColor="Transparent" 
                                TextColor="{StaticResource MutedText}" 
                                Padding="0" 
                                HeightRequest="32">
                            <Button.Triggers>
                                <DataTrigger Binding="{Binding IsCalendarView}" TargetType="Button" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="CornerRadius" Value="0" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" 
                                Text="List Feed" 
                                Command="{Binding ShowListViewCommand}"
                                FontSize="12" 
                                FontFamily="OpenSansSemibold" 
                                BackgroundColor="Transparent" 
                                TextColor="{StaticResource MutedText}" 
                                Padding="0" 
                                Margin="0"
                                HeightRequest="32">
                            <Button.Triggers>
                                <DataTrigger Binding="{Binding IsCalendarView}" TargetType="Button" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="CornerRadius" Value="0" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Calendar Card (Visible only in Calendar View) -->
                <CarouselView Grid.Row="1"
                              ItemsSource="{Binding MonthPages}"
                              Position="{Binding CurrentPagePosition, Mode=TwoWay}"
                              IsSwipeEnabled="True"
                              Loop="False"
                              IsVisible="{Binding IsCalendarView}">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                        <Label Text="อา" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" FontSize="11" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1" Text="จ" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" FontSize="11" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="2" Text="อ" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" FontSize="11" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="3" Text="พ" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" FontSize="11" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="4" Text="พฤ" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" FontSize="11" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="5" Text="ศ" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" FontSize="11" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="6" Text="ส" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" FontSize="11" FontFamily="OpenSansSemibold" />
                                    </Grid>
                                    <StackLayout>
                                        <CollectionView ItemsSource="{Binding CalendarDays}" SelectionMode="None">
                                            <CollectionView.ItemsLayout>
                                                <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border HeightRequest="56" BackgroundColor="{Binding LightBgColorHex}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ClickDayCommand}" CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                                <Setter Property="StrokeThickness" Value="2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" TargetType="Border" Value="True">
                                                                <Setter Property="Stroke" Value="#BFA9F9" />
                                                                <Setter Property="StrokeThickness" Value="1.5" />
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Grid Padding="4" RowDefinitions="*,Auto,Auto">
                                                            <Label Grid.Row="0" Text="{Binding DayText}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" VerticalOptions="Start" HorizontalOptions="Start" />
                                                            <Label Grid.Row="1" Text="{Binding HoursText}" FontSize="9" FontFamily="OpenSansSemibold" TextColor="{Binding AccentColorHex}" VerticalOptions="Start" HorizontalOptions="Start" />
                                                            <BoxView Grid.Row="2" Margin="0,5,0,0" HeightRequest="3.5" CornerRadius="1.5" Color="{Binding AccentColorHex}" HorizontalOptions="FillAndExpand" IsVisible="{Binding HasEntries}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </StackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <!-- 3. Month Summaries (Visible only in List Feed View) -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsCalendarView, Converter={StaticResource InverseBooleanConverter}}">
                    <Border Style="{StaticResource CompactCard}">
                        <VerticalStackLayout>
                            <Label Text="Period total" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding MonthHoursText}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CompactCard}">
                        <VerticalStackLayout>
                            <Label Text="Earned" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding MonthEarningsText}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- 4. Selected Day logs OR Log OT Button helper (Visible only in Calendar View) -->
                <Border Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource Card}" IsVisible="{Binding IsCalendarView}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Label Text="{Binding SelectedDayText, StringFormat='For {0}'}" Style="{StaticResource SectionTitle}" Margin="0" />
                        
                        <Grid Grid.Row="1">
                            <!-- Case A: Has Logs -->
                            <CollectionView ItemsSource="{Binding SelectedDayEntries}" IsVisible="{Binding HasSelectedDayEntries}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnDefinitions="46,*,40,40" ColumnSpacing="8">
                                            <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource Surface2}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12">
                                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                                    <Label Text="{Binding DayBox}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                                                    <Label Text="{Binding MonthBox}" FontSize="9" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding TypeText}" FontSize="11" TextColor="{StaticResource MutedText}" />
                                                <Label Text="{Binding HoursText}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                                <Label Text="{Binding EarningsText}" FontSize="11" TextColor="{StaticResource GreenMid}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="2" Text="Edit" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource AmberMid}" Padding="0" FontSize="10" />
                                            <Button Grid.Column="3" Text="Del" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource Red}" Padding="0" FontSize="10" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            
                            <!-- Case B: No Logs, display helper button -->
                            <VerticalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center" IsVisible="{Binding HasSelectedDayEntries, Converter={StaticResource InverseBooleanConverter}}">
                                <Label Text="No OT logged for this day" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                                <Button Text="Add OT on this Day" 
                                        Command="{Binding LogSelectedDayCommand}" 
                                        Style="{StaticResource PrimaryButton}" 
                                        HeightRequest="40" 
                                        WidthRequest="180" 
                                        HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 5. List Feed Card (Visible only in List Feed View) -->
                <Border Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource Card}" IsVisible="{Binding IsCalendarView, Converter={StaticResource InverseBooleanConverter}}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <Label Text="All entries" Style="{StaticResource SectionTitle}" Margin="0" />
                        <CollectionView Grid.Row="1" ItemsSource="{Binding MonthEntries}" VerticalOptions="Fill">
                            <CollectionView.EmptyView>
                                <Label Text="No entries in this period." Style="{StaticResource MutedLabel}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnDefinitions="46,*,40,40" ColumnSpacing="8">
                                        <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{StaticResource Surface2}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 12">
                                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                                <Label Text="{Binding DayBox}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding MonthBox}" FontSize="9" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding TypeText}" FontSize="11" TextColor="{StaticResource MutedText}" />
                                            <Label Text="{Binding HoursText}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                            <Label Text="{Binding EarningsText}" FontSize="11" TextColor="{StaticResource GreenMid}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Text="Edit" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource AmberMid}" Padding="0" FontSize="10" />
                                        <Button Grid.Column="3" Text="Del" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource Red}" Padding="0" FontSize="10" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
