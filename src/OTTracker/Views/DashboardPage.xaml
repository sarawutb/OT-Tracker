<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OTTracker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:controls="clr-namespace:OTTracker.Controls"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    Title="OT Dashboard"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <RefreshView 
            Command="{Binding RefreshCommand}"
            Grid.Row="0"
            IsRefreshEnabled="{Binding IsBusy,Converter={StaticResource InverseBooleanConverter}}"
            IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="18,18,18,24" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                        <Label FontAttributes="Bold" Style="{StaticResource MutedLabel}" FontSize="20" Text="{Binding GreetingText}" />
                        <Label
                    Grid.Row="1"
                    FontSize="15"
                    Style="{StaticResource PageTitle}"
                    Text="{Binding MonthText}" />
                        <VerticalStackLayout
                            Grid.RowSpan="2"
                            Grid.Column="2">
                            <Label HorizontalTextAlignment="End"
                               x:Name="HeaderVersionLabel"
                               Margin="0,0,10,3"
                               FontSize="11"
                               TextColor="{StaticResource Ink2}"
                    VerticalOptions="Center" />
                            <Border
                            Padding="12,0"
                            BackgroundColor="{StaticResource AccentLight}"
                            HeightRequest="42"
                            StrokeShape="RoundRectangle 21"
                            StrokeThickness="0"
                            MinimumWidthRequest="42">
                                <Label
                                FontFamily="OpenSansSemibold"
                                HorizontalOptions="Center"
                                Text="{Binding UserName}"
                                TextColor="{StaticResource Accent}"
                                VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Border
                Padding="20"
                BackgroundColor="{StaticResource Accent}"
                StrokeShape="RoundRectangle 22"
                StrokeThickness="0">
                        <VerticalStackLayout Spacing="8">
                            <Label
                        FontSize="11"
                        Text="TOTAL OT THIS PERIOD"
                        TextColor="#CCFFFFFF" />
                            <HorizontalStackLayout Spacing="6">
                                <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="42"
                            Text="{Binding TotalHoursText}"
                            TextColor="White" />
                                <Label
                            Margin="0,0,0,7"
                            FontSize="14"
                            Text="hours"
                            TextColor="#CCFFFFFF"
                            VerticalOptions="End" />
                            </HorizontalStackLayout>
                            <BoxView
                        Margin="0,6"
                        HeightRequest="1"
                        Color="#33FFFFFF" />
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label
                                FontSize="11"
                                Text="ESTIMATED EARNINGS"
                                TextColor="#AAFFFFFF" />
                                    <Label
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                Text="{Binding EarningsText}"
                                TextColor="White" />
                                </VerticalStackLayout>
                                <Switch
                            Grid.Column="1"
                            IsToggled="{Binding MaskEarnings}"
                            OnColor="#AFA9EC"
                            ThumbColor="White" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource CompactCard}">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="This week" />
                                <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="20"
                            Text="{Binding ThisWeekHours, StringFormat='{0:0.##} hrs'}"
                            TextColor="{StaticResource Ink}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CompactCard}">
                            <VerticalStackLayout>
                                <Label Style="{StaticResource MutedLabel}" Text="Entries logged" />
                                <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="20"
                            Text="{Binding ThisWeekEntries, StringFormat='{0} days'}"
                            TextColor="{StaticResource Ink}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="FillAndExpand">
                                <Label
                                    VerticalOptions="CenterAndExpand"
                                    Margin="0"
                                    Style="{StaticResource SectionTitle}"
                                    Text="This week" />
                                <Button
                                    VerticalOptions="CenterAndExpand"
                                    Grid.Column="1"
                                    Padding="12,8"
                                    Text="History"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Accent}"
                                    BackgroundColor="{StaticResource AccentLight}"
                                    ImageSource="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static m:MaterialOutlined.History}, Color={StaticResource Accent}, Size=16}"
                                    Command="{Binding GoHistoryCommand}"/>
                            </Grid>
                            <CollectionView
                                HorizontalOptions="Fill"
                                HorizontalScrollBarVisibility="Never"
                                ItemsSource="{Binding WeeklySummaries}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout
                                HorizontalItemSpacing="4"
                                Orientation="Vertical"
                                Span="7"
                                VerticalItemSpacing="0" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid RowDefinitions="*,Auto" HeightRequest="120" HorizontalOptions="Fill">
                                            <VerticalStackLayout Grid.Row="0" VerticalOptions="End" HorizontalOptions="Fill" Spacing="4">
                                                <Label
                                                    FontSize="10"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{Binding Hours, StringFormat='{0:0.#}'}"
                                                    TextColor="{StaticResource Ink2}" />
                                                <BoxView
                                                    HorizontalOptions="Center"
                                                    HeightRequest="{Binding BarHeight}"
                                                    VerticalOptions="End"
                                                    WidthRequest="26"
                                                    Color="{StaticResource GreenMid}">
                                                    <BoxView.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsWeekend}"
                                                            TargetType="BoxView"
                                                            Value="True">
                                                            <Setter Property="Color" Value="{StaticResource AmberMid}" />
                                                        </DataTrigger>
                                                    </BoxView.Triggers>
                                                </BoxView>
                                            </VerticalStackLayout>
                                            <Label
                                                Grid.Row="1"
                                                Margin="0,4,0,0"
                                                FontSize="10"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Day}"
                                                TextColor="{StaticResource MutedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <HorizontalStackLayout Spacing="14">
                                <Label
                            FontSize="11"
                            Text="Weekday"
                            TextColor="{StaticResource GreenMid}" />
                                <Label
                            FontSize="11"
                            Text="Weekend"
                            TextColor="{StaticResource AmberMid}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Day Type Distribution Card -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="12">
                            <Label Style="{StaticResource SectionTitle}" Text="OT Distribution by Day Type" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="14" Margin="0,4,0,0">
                                <!-- Weekday (x1.5) -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Regular Workday (x1.5)" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                        <Label Grid.Column="1" Text="{Binding RegularHours, StringFormat='{0:0.##} hrs'}" FontSize="12" TextColor="{StaticResource Ink2}" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding RegularPercentage}" ProgressColor="{StaticResource GreenMid}" HeightRequest="8" ScaleY="2.0" HorizontalOptions="FillAndExpand" />
                                </VerticalStackLayout>
                                
                                <!-- Weekend (x2.0) -->
                                <VerticalStackLayout Grid.Row="1" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Weekend (x2.0)" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                        <Label Grid.Column="1" Text="{Binding WeekendHours, StringFormat='{0:0.##} hrs'}" FontSize="12" TextColor="{StaticResource Ink2}" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding WeekendPercentage}" ProgressColor="{StaticResource AmberMid}" HeightRequest="8" ScaleY="2.0" HorizontalOptions="FillAndExpand" />
                                </VerticalStackLayout>
                                
                                <!-- Public Holiday (x3.0) -->
                                <VerticalStackLayout Grid.Row="2" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Public Holiday (x3.0)" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                        <Label Grid.Column="1" Text="{Binding HolidayHours, StringFormat='{0:0.##} hrs'}" FontSize="12" TextColor="{StaticResource Ink2}" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding HolidayPercentage}" ProgressColor="#E04F5F" HeightRequest="8" ScaleY="2.0" HorizontalOptions="FillAndExpand" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 6-Month Trend Chart Card -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="16">
                            <Label Style="{StaticResource SectionTitle}" Text="6-Month Trend" />
                            <CollectionView
                                HorizontalOptions="Fill"
                                HorizontalScrollBarVisibility="Never"
                                ItemsSource="{Binding MonthlyTrendSummaries}">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout
                                        HorizontalItemSpacing="4"
                                        Orientation="Vertical"
                                        Span="6"
                                        VerticalItemSpacing="0" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid RowDefinitions="*,Auto" HeightRequest="140" HorizontalOptions="Fill">
                                            <VerticalStackLayout Grid.Row="0" VerticalOptions="End" HorizontalOptions="Fill" Spacing="6">
                                                <Label
                                                    FontSize="9"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{Binding Hours, StringFormat='{0:0.#}h'}"
                                                    TextColor="{StaticResource Ink2}" />
                                                <BoxView
                                                    HorizontalOptions="Center"
                                                    HeightRequest="{Binding BarHeight}"
                                                    VerticalOptions="End"
                                                    WidthRequest="28"
                                                    Color="{StaticResource Accent}"
                                                    CornerRadius="4" />
                                            </VerticalStackLayout>
                                            <Label
                                                Grid.Row="1"
                                                Margin="0,6,0,0"
                                                FontSize="10"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding MonthName}"
                                                TextColor="{StaticResource MutedText}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Key Metrics Card -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="12">
                            <Label Style="{StaticResource SectionTitle}" Text="Key Productivity Metrics" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" Margin="0,4,0,0">
                                <!-- Col 0 Row 0: Average OT Hours/Log -->
                                <Border StrokeThickness="0" BackgroundColor="{StaticResource AccentLight}" StrokeShape="RoundRectangle 12" Padding="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Average OT/Entry" FontSize="10" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding AverageHoursPerEntry, StringFormat='{0:0.##} hrs'}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                </Border>
                                
                                <!-- Col 1 Row 0: Max OT Hours Single Day -->
                                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource AccentLight}" StrokeShape="RoundRectangle 12" Padding="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Max Single Log" FontSize="10" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding MaxHoursSingleEntry, StringFormat='{0:0.##} hrs'}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Col 0 Row 1: Regular Workday Ratio -->
                                <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="{StaticResource AccentLight}" StrokeShape="RoundRectangle 12" Padding="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Workday Ratio" FontSize="10" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding RegularRatioText}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Col 1 Row 1: Projected OT Hours -->
                                <Border Grid.Row="1" Grid.Column="1" StrokeThickness="0" BackgroundColor="{StaticResource GreenLight}" StrokeShape="RoundRectangle 12" Padding="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Projected Period" FontSize="10" TextColor="{StaticResource Green}" FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding ProjectedHours, StringFormat='{0:0.##} hrs'}" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource Green}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label
                        Margin="0,0,0,4"
                        Style="{StaticResource SectionTitle}"
                        Text="Recent entries" />
                            <CollectionView ItemsSource="{Binding RecentEntries}">
                                <CollectionView.EmptyView>
                                    <Label Style="{StaticResource MutedLabel}" Text="No OT entries yet." />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                    Padding="0,8"
                                    ColumnDefinitions="42,*,Auto"
                                    ColumnSpacing="10">
                                            <Border
                                        BackgroundColor="{StaticResource AccentLight}"
                                        HeightRequest="36"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        WidthRequest="36">
                                                <Label
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            Text="OT"
                                            TextColor="{StaticResource Accent}"
                                            VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            Text="{Binding DateText}"
                                            TextColor="{StaticResource Ink}" />
                                                <Label
                                            FontSize="11"
                                            Text="{Binding TimeText}"
                                            TextColor="{StaticResource MutedText}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout
                                        Grid.Column="2"
                                        HorizontalOptions="End"
                                        Spacing="1">
                                                <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="13"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding HoursText}"
                                            TextColor="{StaticResource Ink}" />
                                                <Label
                                            FontSize="11"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding EarningsText}"
                                            TextColor="{StaticResource GreenMid}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <controls:AppTabBar Grid.Row="1" ActiveRoute="Dashboard" />
    </Grid>
</ContentPage>
